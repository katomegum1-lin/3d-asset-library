<view class="page" style="{{styleVars}}">

  <view class="brand">
    <view class="logo">3D</view>
    <text class="title">三维资产库</text>
    <text class="desc">登录后可保存你的偏好设置</text>
  </view>

  <view class="form">
    <!-- 头像 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-empty">
        <text>+</text>
      </view>
    </button>
    <text class="avatar-tip">点击选择头像</text>

    <!-- 昵称 -->
    <view class="field">
      <text class="label">昵称</text>
      <input
        class="input"
        type="nickname"
        placeholder="请输入昵称"
        placeholder-class="ph"
        value="{{nickName}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
      />
    </view>

    <button class="primary" bindtap="onSubmit">进入资产库</button>
    <button class="ghost" bindtap="onSkip">先逛逛</button>
  </view>

  <text class="foot">头像和昵称只保存在本机，不会上传</text>
</view>
