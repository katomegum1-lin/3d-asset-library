page {
  background: var(--page-bg, #0f1216);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 60rpx;
  background: var(--page-bg, #0f1216);
  color: var(--text, #e8ecf1);
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: var(--accent, #4c9aff);
  color: #0f1216;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(76, 154, 255, 0.28);
}

.title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 600;
}

.desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--sub, #7d8794);
}

.form {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border, #232a33);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg, #171c22);
  color: var(--sub, #7d8794);
  font-size: 56rpx;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--sub, #7d8794);
}

.field {
  width: 100%;
  margin-top: 64rpx;
  background: var(--card-bg, #171c22);
  border: 1rpx solid var(--border, #232a33);
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  display: flex;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: var(--sub, #7d8794);
  margin-right: 24rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text, #e8ecf1);
}

.ph {
  color: #5b6470;
}

.primary {
  width: 100%;
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: var(--accent, #4c9aff);
  color: #0f1216;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.primary::after,
.ghost::after {
  border: none;
}

.ghost {
  width: 100%;
  margin-top: 24rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: transparent;
  color: var(--sub, #7d8794);
  font-size: 28rpx;
  border: none;
}

.foot {
  margin-top: auto;
  padding-top: 60rpx;
  font-size: 22rpx;
  color: var(--sub, #7d8794);
}
