page {
  height: 100vh;
  overflow: hidden;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--page-bg, #0f1216);
}

/* 3D 画布必须给明确宽高，否则不渲染 */
.xr-view {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
}

/* ---------- 顶部信息 ---------- */
.hud {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: none;
}

.hud-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text, #e8ecf1);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.55);
}

.hud-tip {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--sub, #7d8794);
}

.hud-badge {
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(76, 154, 255, 0.16);
  color: var(--accent, #4c9aff);
  font-size: 21rpx;
}

/* ---------- 分享按钮 ---------- */
.share-btn {
  position: absolute;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--page-bg, #0f1216);
  background: var(--text, #e8ecf1);
  border: none;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.28);
}

.share-btn::after {
  border: none;
}

/* ---------- 遮罩 ---------- */
.mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--page-bg, #0f1216);
  opacity: 0.94;
}

.mask-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--sub, #7d8794);
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border, #232a33);
  border-top-color: var(--accent, #4c9aff);
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.err-text {
  padding: 0 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ff7b72;
}
