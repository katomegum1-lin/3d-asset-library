page {
  background: var(--page-bg, #0f1216);
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  background: var(--page-bg, #0f1216);
  color: var(--text, #e8ecf1);
}

/* ---------- 顶部 ---------- */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.user {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border, #232a33);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-bg, #171c22);
  color: var(--sub, #7d8794);
  font-size: 28rpx;
}

.head-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-left: 24rpx;
  min-width: 0;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--sub, #7d8794);
}

.theme-btn {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid var(--border, #232a33);
  font-size: 24rpx;
  color: var(--sub, #7d8794);
}

.tap-dim {
  opacity: 0.6;
}

/* ---------- 提示 ---------- */
.banner {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 176, 32, 0.12);
  color: #ffb020;
  font-size: 24rpx;
}

.tip {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--sub, #7d8794);
}

/* ---------- 导入按钮 ---------- */
.actions {
  margin-bottom: 24rpx;
}

.action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx;
  border-radius: 18rpx;
  border: 2rpx dashed var(--border, #232a33);
}

.action-icon {
  font-size: 32rpx;
  color: var(--accent, #4c9aff);
  margin-right: 14rpx;
}

.action-text {
  font-size: 26rpx;
  color: var(--sub, #7d8794);
}

.action-help {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--sub, #7d8794);
  opacity: 0.75;
  text-decoration: underline;
}

/* ---------- 卡片列表 ---------- */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--card-bg, #171c22);
  border: 1rpx solid var(--border, #232a33);
  transition: transform 0.15s ease;
}

.card-hover {
  transform: scale(0.985);
  opacity: 0.9;
}

.thumb-wrap {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--page-bg, #0f1216);
}

.thumb {
  width: 100%;
  height: 100%;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sub, #7d8794);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  opacity: 0.6;
}

.meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 22rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--sub, #7d8794);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--accent, #4c9aff);
  opacity: 0.8;
}

.size {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--sub, #7d8794);
  opacity: 0.75;
}

.arrow {
  flex-shrink: 0;
  padding-right: 8rpx;
  font-size: 40rpx;
  color: var(--sub, #7d8794);
  opacity: 0.5;
}

.del {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(227, 75, 75, 0.45);
  color: #e34b4b;
  font-size: 23rpx;
}
